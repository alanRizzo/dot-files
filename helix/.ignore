# Helix file picker ignore patterns
# These patterns are excluded from file picker and global search

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# Virtual environments
.venv/
venv/
ENV/
env/
.virtualenv/

# IDEs and editors
.vscode/
.idea/
*.swp
*.swo
*~
.helix/

# OS
.DS_Store
.AppleDouble
.LSOverride
._*

# Node
node_modules/
npm-debug.log
yarn-error.log

# Git
.git/

# Temporary files
*.tmp
*.temp
*.log
